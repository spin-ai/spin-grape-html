  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "express": "^4.21.2",
    "grapesjs": "^0.22.5",
    "mermaid": "^10.9.8"
  }
}
