# 服务
PORT=8787
HOST=127.0.0.1

# Pi（留空则使用 `pi` 的默认模型与凭据配置）
# PI_PROVIDER=deepseek
# PI_MODEL=deepseek-chat
# PI_THINKING=high
# PI_BIN=/opt/homebrew/bin/pi

# 允许 Pi 使用的工具（含本项目的 canvas_state / canvas_reload）
# PI_TOOLS=read,edit,write,bash,canvas_state,canvas_reload

# 追加到系统提示的项目约定（也可以直接写 site/AGENTS.md）
# CANVAS_RULES=所有文案使用简体中文，不要使用感叹号。

# 扩展访问画布状态的令牌，不填时自动随机生成
# CANVAS_TOKEN=change-me

# 打印 Pi 的 stderr（调试扩展/模型问题时打开）
# PI_DEBUG=1
